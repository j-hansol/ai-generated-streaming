{
  "name": "streaming",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-ports.mjs && concurrently -k -n media,server,web -c magenta,blue,green \"pnpm:dev:media\" \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:media": "node scripts/mediamtx.mjs",
    "dev:server": "pnpm --filter @streaming/server dev",
    "dev:web": "pnpm --filter @streaming/web dev",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "typescript-ide": "npm:typescript@^6.0.3"
  }
}
